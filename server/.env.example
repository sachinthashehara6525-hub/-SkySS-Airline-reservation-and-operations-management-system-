# Copy this file to .env and put your own PostgreSQL password in it.
# If the password has special characters (@ : / #), URL-encode them.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/skyss
PORT=3001

# Booking confirmation emails (Gmail). Use a Google App Password, not your normal password.
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=your16letterapppassword

# First staff account for the Operations tab. If ADMIN_PASSWORD is empty, a password is generated and printed once.
ADMIN_EMAIL=admin@skyss.local
ADMIN_PASSWORD=

# Optional: Google sign-in. Paste the Client ID from Google Cloud Console (it is not a secret).
GOOGLE_CLIENT_ID=
